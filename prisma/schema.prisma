// Prisma schema for itinerary-creation
// Database: MySQL | ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Person who owns saved itineraries. Created from the signed-in email.
model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  image         String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  itineraries Itinerary[]

  @@index([createdAt])
  @@map("users")
}

/// Saved generated trip itinerary owned by a user.
model Itinerary {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  userId           String
  destination      String   @db.VarChar(255)
  days             Int      @db.UnsignedTinyInt
  destinationType  String   @db.VarChar(64)
  travelStyle      String   @db.VarChar(64)
  budget           String   @db.VarChar(64)
  startingLocation String   @db.VarChar(255)
  content          String   @db.MediumText
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([travelStyle])
  @@index([destination])
  @@map("itineraries")
}
