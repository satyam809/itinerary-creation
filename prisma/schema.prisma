// Prisma schema for itinerary-creation
// Database: MySQL | ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Trip styles supported by the itinerary create form and generate API.
enum TripType {
  adventure
  relaxation
  cultural
  business
  family
  romantic
  backpacking
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Application user, typically created from Google OAuth (NextAuth).
model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  image         String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  itineraries Itinerary[]

  @@index([createdAt])
  @@map("users")
}

/// OAuth provider account linked to a user (e.g. Google).
/// Compatible with @next-auth/prisma-adapter Account model.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String? @db.VarChar(255)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Saved generated trip itinerary owned by a user.
model Itinerary {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  userId      String
  destination String   @db.VarChar(255)
  days        Int      @db.UnsignedTinyInt
  tripType    TripType
  content     String   @db.MediumText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([tripType])
  @@index([destination])
  @@map("itineraries")
}
